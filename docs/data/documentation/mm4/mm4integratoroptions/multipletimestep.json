{"abstract":[{"type":"text","text":"Executes bonded forces at twice the rate of nonbonded forces."}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/mm4\/mm4integratoroptions\/multipletimestep"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"multipleTimeStep"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"text":"The default time step is 4.35 fs.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This integrator uses a multiple time-stepping (MTS) scheme. Cheaper bonded"},{"type":"text","text":" "},{"type":"text","text":"forces, such as bond-stretch and bond-bend, are only stable at ~2 fs"},{"type":"text","text":" "},{"type":"text","text":"without constraints. Expensive forces like nonbonded and electrostatic"},{"type":"text","text":" "},{"type":"text","text":"can execute at ~4 fs."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"MTS has a smaller coefficient to O(n) scaling than the"},{"type":"text","text":" "},{"type":"text","text":"Verlet integrator. However, it has a larger O(1) prefactor. Only use"},{"type":"text","text":" "},{"type":"text","text":"it for large systems that are not latency-bound."}],"type":"paragraph"}]}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"multipleTimeStep"}],"roleHeading":"Case","externalID":"s:3MM40A17IntegratorOptionsO16multipleTimeStepyA2CmF","role":"symbol","modules":[{"name":"MM4"}],"title":"MM4IntegratorOptions.multipleTimeStep","symbolKind":"case"},"identifier":{"url":"doc:\/\/MM4\/documentation\/MM4\/MM4IntegratorOptions\/multipleTimeStep","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/MM4\/documentation\/MM4","doc:\/\/MM4\/documentation\/MM4\/MM4IntegratorOptions"]]},"references":{"doc://MM4/documentation/MM4/MM4IntegratorOptions":{"identifier":"doc:\/\/MM4\/documentation\/MM4\/MM4IntegratorOptions","navigatorTitle":[{"kind":"identifier","text":"MM4IntegratorOptions"}],"role":"symbol","abstract":[{"type":"text","text":"Options for customizing the integrator used for simulation."}],"type":"topic","kind":"symbol","title":"MM4IntegratorOptions","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MM4IntegratorOptions"}],"url":"\/documentation\/mm4\/mm4integratoroptions"},"doc://MM4/documentation/MM4/MM4IntegratorOptions/multipleTimeStep":{"kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/MM4\/documentation\/MM4\/MM4IntegratorOptions\/multipleTimeStep","abstract":[{"type":"text","text":"Executes bonded forces at twice the rate of nonbonded forces."}],"title":"MM4IntegratorOptions.multipleTimeStep","url":"\/documentation\/mm4\/mm4integratoroptions\/multipletimestep","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"multipleTimeStep","kind":"identifier"}]},"doc://MM4/documentation/MM4":{"identifier":"doc:\/\/MM4\/documentation\/MM4","abstract":[{"text":"Molecular Mechanics force field, version 4. The simulator used to create ","type":"text"},{"inlineContent":[{"text":"Nanosystems (1992)","type":"text"}],"type":"emphasis"},{"text":", but updated with modern ab initio parameters.","type":"text"}],"kind":"symbol","title":"MM4","role":"collection","type":"topic","url":"\/documentation\/mm4"}}}