{"sections":[],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"cutoffDistance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sf","text":"Float"},{"kind":"text","text":"?"}]}],"kind":"declarations"},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The default value is 1.0 nm. This is 2.86σ for carbon and 2.45σ for"},{"type":"text","text":" "},{"type":"text","text":"silicon."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Since germanium will rarely be used, use the 2.5σ cutoff for silicon. The"},{"type":"text","text":" "},{"type":"text","text":"slightly greater sigma for carbon allows greater accuracy in vdW forces"},{"type":"text","text":" "},{"type":"text","text":"for bulk diamond. 1.0 nm is also sufficient for charge-charge"},{"type":"text","text":" "},{"type":"text","text":"interactions."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the cutoff distance is "},{"code":"nil","type":"codeVoice"},{"type":"text","text":", nonbonded forces are computed with the"},{"type":"text","text":" "},{"type":"text","text":"full O(n^2) cost. This may increase simulation speed for small-enough"},{"type":"text","text":" "},{"type":"text","text":"systems and large-enough GPUs."}]}],"kind":"content"}],"metadata":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"cutoffDistance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Float","preciseIdentifier":"s:Sf"},{"kind":"text","text":"?"}],"externalID":"s:3MM40A20ForceFieldDescriptorV14cutoffDistanceSfSgvp","role":"symbol","title":"cutoffDistance","modules":[{"name":"MM4"}],"roleHeading":"Instance Property","symbolKind":"property"},"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MM4\/documentation\/MM4\/MM4ForceFieldDescriptor\/cutoffDistance"},"kind":"symbol","abstract":[{"type":"text","text":"Required. The cutoff to use for nonbonded interactions."}],"hierarchy":{"paths":[["doc:\/\/MM4\/documentation\/MM4","doc:\/\/MM4\/documentation\/MM4\/MM4ForceFieldDescriptor"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/mm4\/mm4forcefielddescriptor\/cutoffdistance"]}],"references":{"doc://MM4/documentation/MM4/MM4ForceFieldDescriptor":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MM4ForceFieldDescriptor","kind":"identifier"}],"identifier":"doc:\/\/MM4\/documentation\/MM4\/MM4ForceFieldDescriptor","url":"\/documentation\/mm4\/mm4forcefielddescriptor","title":"MM4ForceFieldDescriptor","abstract":[{"text":"A configuration for a force field.","type":"text"}],"type":"topic","navigatorTitle":[{"text":"MM4ForceFieldDescriptor","kind":"identifier"}],"kind":"symbol","role":"symbol"},"doc://MM4/documentation/MM4":{"identifier":"doc:\/\/MM4\/documentation\/MM4","abstract":[{"text":"Molecular Mechanics force field, version 4. The simulator used to create ","type":"text"},{"inlineContent":[{"text":"Nanosystems (1992)","type":"text"}],"type":"emphasis"},{"text":", but updated with modern ab initio parameters.","type":"text"}],"kind":"symbol","title":"MM4","role":"collection","type":"topic","url":"\/documentation\/mm4"},"doc://MM4/documentation/MM4/MM4ForceFieldDescriptor/cutoffDistance":{"identifier":"doc:\/\/MM4\/documentation\/MM4\/MM4ForceFieldDescriptor\/cutoffDistance","kind":"symbol","url":"\/documentation\/mm4\/mm4forcefielddescriptor\/cutoffdistance","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"cutoffDistance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Float","preciseIdentifier":"s:Sf"},{"kind":"text","text":"?"}],"role":"symbol","title":"cutoffDistan