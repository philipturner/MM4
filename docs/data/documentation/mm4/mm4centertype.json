{"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MM4CenterType"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"For non-carbon atoms, the center type reflects what it would be, if the atom"},{"type":"text","text":" "},{"type":"text","text":"were replaced with a carbon, and its lone pairs replaced with hydrogens."}],"type":"paragraph"},{"inlineContent":[{"text":"Methane carbons are disallowed in the simulator, as they will be simulated","type":"text"},{"text":" ","type":"text"},{"text":"very inaccurately. The fluorine parameters struggle with the edge case of","type":"text"},{"text":" ","type":"text"},{"text":"carbon tetrafluoride, and HMR creates the nonphysical carbon-8 isotope. In","type":"text"},{"text":" ","type":"text"},{"text":"general, primary sp3 carbons are also discouraged, for the same reasons","type":"text"},{"text":" ","type":"text"},{"text":"that methane is prohibited.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","metadata":{"title":"MM4CenterType","role":"symbol","roleHeading":"Enumeration","symbolKind":"enum","fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"text":"MM4CenterType","kind":"identifier"}],"navigatorTitle":[{"text":"MM4CenterType","kind":"identifier"}],"modules":[{"name":"MM4"}],"externalID":"s:3MM40A10CenterTypeO"},"relationshipsSections":[{"identifiers":["doc:\/\/MM4\/SQ","doc:\/\/MM4\/SH","doc:\/\/MM4\/SY","doc:\/\/MM4\/s8SendableP","doc:\/\/MM4\/s16SendableMetatypeP"],"type":"conformsTo","title":"Conforms To","kind":"relationships"}],"variants":[{"paths":["\/documentation\/mm4\/mm4centertype"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/MM4\/documentation\/MM4"]]},"identifier":{"url":"doc:\/\/MM4\/documentation\/MM4\/M